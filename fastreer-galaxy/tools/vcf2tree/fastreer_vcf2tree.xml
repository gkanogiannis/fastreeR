<tool id="fastreer_vcf2tree" name="VCF2TREE" version="1.13.27">
    <description>Newick tree from VCF files</description>
    <requirements>
        <requirement type="package">fastreer=1.13.27</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
    fastreeR VCF2TREE 
    #for $f in $input_vcfs:
        -i '$f'
    #end for
    -o '$output'
    --threads \${GALAXY_SLOTS:-1}
    #if $ignoreHets:
        --ignoreHets
    #end if
    #if $onlyHets:
        --onlyHets
    #end if
    #if $ignoreMissing:
        --ignoreMissing
    #end if
    #if $verbose:
        --verbose
    #end if
    ]]></command>
    <inputs>
        <param name="input_vcfs" type="data" format="vcf" multiple="true" label="VCF input files"/>
        <param name="ignoreHets" type="boolean" checked="false" label="Ignore heterozygous loci"/>
        <param name="onlyHets" type="boolean" checked="false" label="Use only heterozygous loci"/>
        <param name="ignoreMissing" type="boolean" checked="false" label="Ignore missing loci"/>
        <param name="verbose" type="boolean" checked="true" label="Verbose logging"/>
    </inputs>
    <outputs>
        <data name="output" format="newick" label="Output Tree"/>
    </outputs>
    <tests>
        <test>
            <param name="input_vcfs" value="test.vcf"/>
            <param name="verbose" value="true"/>
            <output name="output" file="expected.nwk"/>
        </test>
    </tests>
    <help><![CDATA[
        Computes a phylogenetic tree from one or more VCF files using neighbor-joining.
        Optional flags control handling of heterozygous and missing loci.
    ]]></help>
    <citations>
        <citation type="doi">10.1186/s12859-016-1186-3</citation>
    </citations>
</tool>
