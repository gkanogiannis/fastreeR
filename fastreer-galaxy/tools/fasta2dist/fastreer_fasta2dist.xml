<tool id="fastreer_fasta2dist" name="FASTA2DIST" version="1.13.30">
    <description>Compute D2S distance matrix from FASTA file(s)</description>
    <requirements>
        <requirement type="package">fastreer=1.13.30</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
    fastreeR FASTA2DIST
    #for $f in $input_fastas:
        -i '$f'
    #end for
    -o '$output'
    --threads \${GALAXY_SLOTS:-1}
    -k $kmer_size
    #if $normalize:
        --normalize
    #end if
    #if $verbose:
        --verbose
    #end if     
    ]]></command>
    <inputs>
        <param name="input_fastas" type="data" format="fasta" multiple="true" label="FASTA input files"/>
        <param name="kmer_size" type="integer" value="4" label="K-mer size"/>
        <param name="normalize" type="boolean" label="Use normalized D2S distance"/>
        <param name="verbose" type="boolean" checked="true" label="Verbose logging"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="Distance matrix"/>
    </outputs>
    <tests>
        <test>
            <param name="input_fastas" value="test.fasta"/>
            <param name="verbose" value="true"/>
            <output name="output" file="expected.dist"/>
        </test>
    </tests>
    <help></help>
    <help><![CDATA[
        This tool computes a D2S k-mer based distance matrix from one or more FASTA files.
        Supports multithreaded execution.
    ]]></help>
    <citations>
        <citation type="doi">10.1186/s12859-016-1186-3</citation>
    </citations>
</tool>
