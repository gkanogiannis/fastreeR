<tool id="fastreer_vcf2tree" name="VCF2TREE" version="2.1.0">
    <description>Newick tree from VCF files</description>
    <requirements>
        <requirement type="package">fastreer=2.1.0</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
    fastreeR VCF2TREE 
    #for $f in $input_vcfs:
        -i '$f'
    #end for
    -o '$output'
    -b $bootstraps
    --threads \${GALAXY_SLOTS:-1}
    #if $verbose:
        --verbose
    #end if
    ]]></command>
    <inputs>
        <param name="input_vcfs" type="data" format="vcf" multiple="true" label="VCF input files"/>
        <param name="bootstraps" type="integer" value="0" label="Number of bootstrap replicates"/>
        <param name="verbose" type="boolean" checked="true" label="Verbose logging"/>
    </inputs>
    <outputs>
        <data name="output" format="newick" label="Output Tree"/>
    </outputs>
    <tests>
        <test>
            <param name="input_vcfs" value="test.vcf"/>
            <param name="verbose" value="true"/>
            <output name="output" file="expected.nwk"/>
        </test>
    </tests>
    <help><![CDATA[
        Computes a phylogenetic tree from one or more VCF files using neighbor-joining.
        Optional parameter for bootsrapping support calculation.
    ]]></help>
    <citations>
        <citation type="doi">10.1186/s12859-016-1186-3</citation>
        <citation type="bibtex">@ARTICLE{gkanogiannis2016,
            title    = "A scalable assembly-free variable selection algorithm for biomarker discovery from metagenomes",
            author   = "Anestis Gkanogiannis and Thomas Bruls",
            journal  = "BMC Bioinformatics",
            year     = "2016",
            volume   = "Aug 19;17(1):311",
            doi = "10.1186/s12859-016-1186-3",
            url = "https://dx.doi.org/10.1186/s12859-016-1186-3"
            }
        </citation>
    </citations>
</tool>
