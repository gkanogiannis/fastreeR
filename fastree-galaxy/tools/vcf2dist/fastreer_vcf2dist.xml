<tool id="fastreer_vcf2dist" name="VCF2DIST" version="1.13.26">
    <description>Cosine distance matrix from VCF files</description>
    <requirements>
        <requirement type="package">fastreer=1.13.26</requirement>
    </requirements>
    <command detect_errors="exit_code"><![CDATA[
    fastreeR VCF2DIST 
    #for $f in $input_vcfs:
        -i '$f'   
    #end for
    -o '$output'
    --threads \${GALAXY_SLOTS:-1}
    #if $ignoreHets:
        --ignoreHets
    #end if
    #if $onlyHets:
        --onlyHets
    #end if
    #if $ignoreMissing:
        --ignoreMissing
    #end if
    #if $verbose:
        --verbose
    #end if
    ]]></command>
    <inputs>
        <param name="input_vcfs" type="data" format="vcf" multiple="true" label="VCF input files"/>
        <param name="ignoreHets" type="boolean" checked="false" label="Ignore heterozygous loci"/>
        <param name="onlyHets" type="boolean" checked="false" label="Use only heterozygous loci"/>
        <param name="ignoreMissing" type="boolean" checked="false" label="Ignore missing loci"/>
        <param name="verbose" type="boolean" checked="true" label="Verbose logging"/>
    </inputs>
    <outputs>
        <data name="output" format="txt" label="Distance Matrix"/>
    </outputs>
    <tests>
        <test>
            <param name="input_vcfs" value="test.vcf"/>
            <param name="verbose" value="true"/>
            <output name="output" file="expected.dist"/>
        </test>
    </tests>
    <help><![CDATA[
        Computes a cosine dissimilarity matrix between all samples in one or more VCF files.
        Supports multithreaded execution and filtering options for heterozygosity and missing data.
    ]]></help>
    <citations>
        <citation type="doi">10.1186/s12859-016-1186-3</citation>
    </citations>
</tool>
